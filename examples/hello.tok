# Tok v0.6

p "Tok v0.6"

# better space args + pipe chains
p "hello world" | upper | lower
nums = [5, 1, 8, 3]
p nums | sorted
p nums | sum
p nums | max

# space-separated multi-arg now works better
write "out.txt" "Hello from Tok v0.6"
p read "out.txt"
p exists "out.txt"

f x in [10, 20, 30]:
  p x

f double n:
  n * 2
p double 21

p "done"
