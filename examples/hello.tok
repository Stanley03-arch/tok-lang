# Tok v1.3

p "=== Tok v1.3 ==="
p version()

# assert
assert 1 + 1 == 2
p "assert ok"

try:
  assert 1 == 0
catch e:
  p "caught bad assert"

# core still works
record Point x y:
  f sum:
    self.x + self.y
p Point(3, 4).sum()

f double n:
  n * 2
p map(double, [1, 2, 3])

p [x * 10 for x in [1, 2, 3] if x > 1]

a = agent("T", "test")
f echo q:
  "echo:" + q
add_tool(a, tool("echo", echo))
p run_agent(a, "hi")

p "=== done ==="
