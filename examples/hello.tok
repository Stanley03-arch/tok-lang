# Tok v0.5

p "Tok v0.5"

nums = [1, 2, 3, 4]
p nums[0]
nums[1] = 99
p nums

# pipe (density win)
p "hello" | upper
p [1, 2, 3] | len

# for-in
f x in nums:
  p x

# file I/O (use parentheses for multiple args)
write("tok_test.txt", "Hello from Tok v0.5")
p read("tok_test.txt")
p exists("tok_test.txt")

person = {"name": "Tok", "ver": 5}
p person.name

f add a b:
  a + b
p add 10 20

p "done"
