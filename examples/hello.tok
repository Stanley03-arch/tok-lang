# Tok v0.9

p "=== Tok v0.9 ==="

# Records with methods
record Person name age:
  f greet:
    "Hi, I am " + self.name
  f older n:
    self.age + n

bob = Person("Bob", 30)
p bob.name
p bob.greet()
p bob.older(5)

# Agents
a = agent("Helper", "help users")
remember(a, "prefers density")
add_tool(a, tool("search"))
p run_agent(a)

# Classic features still work
nums = [1, 2, 3, 4]
p [x * 2 for x in nums if x > 1]
p nums | sum

lang = "Tok"
p "Hello from {lang}"

import examples/math
p square(7)

p "=== done ==="
