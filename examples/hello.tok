# Tok v1.2

p "=== Tok v1.2 ==="

p contains([1,2,3], 2)
p json_dumps({"v": 1.2})

try:
  x = 1 / 0
catch e:
  p "caught"

record Person name:
  f greet:
    "Hi " + self.name
p Person("Tok").greet()

f search q:
  "found:" + q
f summarize q:
  "summary:" + q

a = agent("Bot", "research")
add_tool(a, tool("search", search))
add_tool(a, tool("summarize", summarize))
p run_agent(a, "density")
p run_steps(a, ["density", "tokens"])

write("tok_tmp.txt", "hello from tok")
p read("tok_tmp.txt")
append("tok_tmp.txt", "!")
p read("tok_tmp.txt")

p "=== done ==="
