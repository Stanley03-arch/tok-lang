# Tok v1.4

p "=== Tok v1.4 ==="
p version()

# break in while
n = 0
w n < 10:
  n = n + 1
  i n == 3:
    break
  p n
p "after while"

# continue in for
f i = 1..5:
  i i == 3:
    continue
  p i

assert true
p "assert ok"

f echo q:
  "got:" + q
a = agent("A", "t")
add_tool(a, tool("echo", echo))
p run_agent(a, "hi")

p [x for x in [1,2,3,4] if x > 2]

p "=== done ==="
