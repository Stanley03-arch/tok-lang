# Tok v1.1

p "=== Tok v1.1 ==="

# expanded stdlib
p contains([1,2,3], 2)
p replace("hello world", "world", "Tok")
p startswith("TokLang", "Tok")
p json_dumps({"lang": "Tok", "ver": 1.1})
js = json_dumps({"a": 1})
p json_loads(js)

# try/catch
try:
  x = 1 / 0
catch e:
  p "ok caught"

# OOP
record Person name:
  f greet:
    "Hi " + self.name

record Worker(Person) name job:
  f greet:
    "Worker " + self.name

p Worker("Ann", "dev").greet()

# Agents with real Tok function as tool
f search q:
  "results for: " + q

a = agent("Bot", "search")
add_tool(a, tool("search", search))
p run_agent(a, "token density")

p "=== done ==="
