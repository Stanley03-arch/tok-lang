# Tok v1.5

p "=== Tok v1.5 ==="
p version()

# elif chain
x = 2
i x == 1:
  p "one"
elif x == 2:
  p "two"
elif x == 3:
  p "three"
e:
  p "other"

x = 9
i x < 5:
  p "small"
elif x < 10:
  p "medium"
e:
  p "large"

# break still works
n = 0
w n < 5:
  n = n + 1
  i n == 3:
    break
  p n

assert 1 + 1 == 2
p "ok"

p "=== done ==="
