# Tok v0.8

p "=== Tok v0.8 ==="

nums = [1, 2, 3, 4, 5]
p [x * 10 for x in nums if x > 2]
p nums | sum

lang = "Tok"
p "Running {lang} v0.8"

record Person name age:
  pass
bob = Person("Bob", 30)
p bob.name

a = agent("Helper", "answer questions")
remember(a, "user likes density")
add_tool(a, tool("search"))
p run_agent(a)

import examples/math
p square(6)

f double n:
  n * 2
p map(double, [1, 2, 3])

p "=== done ==="
